# Public configuration; none of these values is a secret.
VITE_GEOHISTORY_API_BASE_URL=http://localhost:8787

# Optional tile-provider overrides. Defaults are CARTO Voyager raster tiles.
# Keep attribution accurate whenever the provider changes.
VITE_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO

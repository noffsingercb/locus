# Public configuration; none of these values is a secret.
VITE_GEOHISTORY_API_BASE_URL=http://localhost:8787

# Optional tile-provider overrides. The built-in default is CARTO Voyager.
# Set both together and preserve the provider's required attribution.
# VITE_TILE_URL=<Leaflet-compatible raster URL template>
# VITE_TILE_ATTRIBUTION=<provider attribution HTML>

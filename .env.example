# Public configuration, not a secret. The GeoHistory API is unauthenticated.
#
# Local development against a locally running API:
VITE_GEOHISTORY_API_BASE_URL=http://localhost:8787
#
# Production builds set this to the deployed GeoHistory origin. The Locus
# production origin must also be appended to ALLOWED_ORIGIN on the GeoHistory
# Render service, or the browser call is refused before it reaches a route.
